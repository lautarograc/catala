This test checks that Catala identifiers clashing with Ruby keywords or with
methods used by the Ruby runtime are renamed, and exercises the Ruby-specific
translation of closures, enumerations and list operators.

```catala
declaration enumeration Shape:
  -- Circle content decimal
  -- Square content decimal
  -- Nothing

declaration structure Box:
  data class content integer
  data hash content Shape
  data value content money

declaration area content decimal depends on s content Shape equals
  match s with pattern
  -- Circle content r: 3.0 * r * r
  -- Square content c: c * c
  -- Nothing: 0.0

#[test]
declaration scope Test:
  internal begin content integer
  internal end content list of integer
  internal self content Box
  internal f content integer depends on x content integer
  output result content decimal
  output sorted content list of integer
  output payment content money

scope Test:
  definition begin equals 2
  definition end equals [3; 1; 2]
  definition f of x equals
    let nil equals x * begin in
    nil + 1
  definition self equals Box {
    -- class: 1
    -- hash: Square content 1.5
    -- value: $10
  }
  definition result equals
    area of self.hash + decimal of (Integer.sum of (map each x among end to f of x))
  definition sorted equals
    sort all x among (list of x among end such that x > 1) in decreasing order of x
  definition payment equals self.value * 1.005
  assertion result = 17.25
  assertion sorted = [3; 2]
  assertion payment = $10.05
```

```catala-test-cli
$ catala ruby
# This file has been generated by the Catala compiler, do not edit!

require 'catala_runtime'
require_relative 'Stdlib_en'
require_relative 'Date_en'
require_relative 'List_en'
require_relative 'Duration_en'
require_relative 'MonthYear_en'
require_relative 'Period_en'
require_relative 'Money_en'
require_relative 'Integer_en'
require_relative 'Decimal_en'

module Catala_program
  class Shape < CatalaRuntime::Enum
    enum_name 'Shape'
    constructor :Circle, 'Circle', :decimal # Decimal
    constructor :Square, 'Square', :decimal # Decimal
    constructor :Nothing, 'Nothing', :unit # Unit
  end

  class Box < CatalaRuntime::Struct
    struct_name 'Box'
    field :class__1, 'class', :integer # Integer
    field :hash__1, 'hash', Shape # Shape
    field :value, 'value', :money # Money
  end

  class Test < CatalaRuntime::Struct
    struct_name 'Test'
    field :result, 'result', :decimal # Decimal
    field :sorted, 'sorted', [:array, :integer] # Array(Integer)
    field :payment, 'payment', :money # Money
  end

  class TestIn < CatalaRuntime::Struct
    struct_name 'Test_in'
  end

  @loc = [CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 27, 12, 27, 13, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 28, 10, 28, 16, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 29, 10, 29, 16, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 30, 10, 30, 17, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 33, 27, 33, 28, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 34, 25, 34, 34, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 36, 5, 37, 12, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 36, 24, 36, 29, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 38, 26, 42, 4, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 44, 5, 44, 85, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 44, 13, 44, 17, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 44, 70, 44, 73, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 46, 5, 46, 84, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 46, 39, 46, 42, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 47, 29, 47, 33, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 47, 29, 47, 47, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 48, 3, 48, 27, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 49, 3, 49, 28, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 49, 13, 49, 28, []), CatalaRuntime::SourcePosition.new('tests/backends/ruby_names.catala_en', 50, 3, 50, 29, [])]
  def self.loc
    @loc
  end

  # (Shape) -> Decimal
  def self.area(s)
    case s.code
    when :Circle
      area__1 = (Rational(3, 1) * s.payload * s.payload)
    when :Square
      area__1 = (s.payload * s.payload)
    when :Nothing
      area__1 = Rational(0, 1)
    end
    return area__1
  end

  # Scope Test
  # (TestIn) -> Test
  def self.test(test_in)
    begin__1 = CatalaRuntime::Option.some(CatalaRuntime::Tuple.new(2, @loc[4]))
    end__1 = CatalaRuntime::Option.some(CatalaRuntime::Tuple.new([3, 1, 2], @loc[5]))
    self__1 = CatalaRuntime::Option.some(CatalaRuntime::Tuple.new(Box.new(class__1: 1, hash__1: Shape.new(:Square, Rational(3, 2)), value: CatalaRuntime::Money.new(1000)), @loc[8]))
    f = ->(x; f__1, nil__1, nil__2) do
      if begin__1.some?
        nil__2 = begin__1.value[0]
      else
        raise CatalaRuntime::NoValue.new(@loc[7])
      end
      nil__1 = (x * nil__2)
      f__1 = CatalaRuntime::Option.some(CatalaRuntime::Tuple.new((nil__1 + 1), @loc[6]))
      if f__1.some?
        return f__1.value[0]
      else
        raise CatalaRuntime::NoValue.new(@loc[0])
      end
    end
    if self__1.some?
      result__1 = self__1.value[0]
    else
      raise CatalaRuntime::NoValue.new(@loc[10])
    end
    result__2 = ->(x__1) do
      return f.call(x__1)
    end
    if end__1.some?
      result__3 = end__1.value[0]
    else
      raise CatalaRuntime::NoValue.new(@loc[11])
    end
    result__4 = CatalaRuntime::Option.some(CatalaRuntime::Tuple.new((area(result__1.hash__1) + CatalaRuntime.decimal_of_integer(::Integer_en.sum(CatalaRuntime.map(result__2, result__3)))), @loc[9]))
    if result__4.some?
      result = result__4.value[0]
    else
      raise CatalaRuntime::NoValue.new(@loc[1])
    end
    sorted__1 = ->(x__2) do
      return x__2
    end
    sorted__2 = ->(x__3) do
      return (x__3 > 1)
    end
    if end__1.some?
      sorted__3 = end__1.value[0]
    else
      raise CatalaRuntime::NoValue.new(@loc[13])
    end
    sorted__4 = CatalaRuntime::Option.some(CatalaRuntime::Tuple.new(CatalaRuntime.sort_desc(sorted__1, CatalaRuntime.filter(sorted__2, sorted__3), @loc[12]), @loc[12]))
    if sorted__4.some?
      sorted = sorted__4.value[0]
    else
      raise CatalaRuntime::NoValue.new(@loc[2])
    end
    if self__1.some?
      payment__1 = self__1.value[0]
    else
      raise CatalaRuntime::NoValue.new(@loc[14])
    end
    payment__2 = CatalaRuntime::Option.some(CatalaRuntime::Tuple.new((payment__1.value * Rational(201, 200)), @loc[15]))
    if payment__2.some?
      payment = payment__2.value[0]
    else
      raise CatalaRuntime::NoValue.new(@loc[3])
    end
    if (!(result == Rational(69, 4)))
      CatalaRuntime.debug_print('result', result)
      raise CatalaRuntime::AssertionFailed.new(@loc[16])
    end
    if (!CatalaRuntime.eq(sorted, [3, 2], @loc[18]))
      CatalaRuntime.debug_print('sorted', sorted)
      raise CatalaRuntime::AssertionFailed.new(@loc[17])
    end
    if (!(payment == CatalaRuntime::Money.new(1005)))
      CatalaRuntime.debug_print('payment', payment)
      raise CatalaRuntime::AssertionFailed.new(@loc[19])
    end
    return Test.new(result: result, sorted: sorted, payment: payment)
  end
end

# Automatic Catala tests
if __FILE__ == $PROGRAM_NAME
  module Catala_program
    CatalaRuntime.run_tests(ARGV, lang: :en, description: 'Catala test program') do |t|
      t.scope('Test') do
        test_test = test(TestIn.new())
        test_test
      end
    end
  end
end
