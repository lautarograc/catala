# frozen_string_literal: true

require_relative 'lib/catala_runtime'

Gem::Specification.new do |spec|
  spec.name = 'catala_runtime'
  spec.version = CatalaRuntime::VERSION
  spec.summary = 'Runtime library needed to execute Catala programs compiled to Ruby'
  spec.description = <<~DESC
    Catala is a domain-specific language for deriving faithful-by-construction
    algorithms from legislative texts. This gem provides the runtime support
    (values, operators, errors, traces) for the Ruby code generated by the
    Catala compiler (`catala ruby`).
  DESC
  spec.homepage = 'https://github.com/CatalaLang/catala'
  spec.license = 'Apache-2.0'
  spec.authors = ['Inria']
  spec.required_ruby_version = '>= 3.0'
  spec.files = ['lib/catala_runtime.rb', 'README.md']
  spec.require_paths = ['lib']
  spec.metadata = {
    'homepage_uri' => spec.homepage,
    'bug_tracker_uri' => 'https://github.com/CatalaLang/catala/issues',
    'rubygems_mfa_required' => 'true'
  }
end
